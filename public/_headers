# Cloudflare static-asset headers (Workers static assets / Pages format).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # script-src/style-src come from Astro's hashed per-page CSP <meta> tag. No default-src
  # here: the two policies intersect, and it would block the hashed inline scripts.
  Content-Security-Policy: img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
