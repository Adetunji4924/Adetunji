{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers with static assets. The Astro build in ./dist is served
  // as-is; only /api/* runs the Worker (the contact form).
  "name": "adetunji",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Where contact-form messages are delivered (must be a verified destination address).
    "CONTACT_TO": "adewoleadetunji77@gmail.com",
    // Sender on your own domain, e.g. "website@yourdomain.com". Leave empty until the
    // domain is bought and onboarded to Email Sending: the form then reports that it
    // can't send, and shows the direct email address instead.
    "CONTACT_FROM": ""
  },
  // The binding may only ever send to this one address, so the form can't be abused
  // to email anyone else.
  "send_email": [{ "name": "EMAIL", "destination_address": "adewoleadetunji77@gmail.com" }],
  "observability": { "enabled": true }
}
