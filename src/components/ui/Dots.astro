---
/** Yellow disc with orbiting dots: the "let's talk" signature. Decorative. */
export interface Props {
  class?: string;
}
const { class: className = 'size-8' } = Astro.props;
---

<span class:list={['dots relative inline-grid shrink-0 place-items-center rounded-full bg-yellow text-night', className]} aria-hidden="true">
  <svg viewBox="0 0 32 32" class="dots-spin size-[70%]">
    <circle cx="16" cy="5" r="2.2" fill="currentColor"></circle>
    <circle cx="25" cy="11" r="1.8" fill="currentColor" opacity=".85"></circle>
    <circle cx="25" cy="21" r="1.5" fill="currentColor" opacity=".7"></circle>
    <circle cx="16" cy="27" r="1.3" fill="currentColor" opacity=".55"></circle>
    <circle cx="7" cy="21" r="1.1" fill="currentColor" opacity=".4"></circle>
    <circle cx="7" cy="11" r="0.9" fill="currentColor" opacity=".25"></circle>
  </svg>
</span>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .dots-spin {
      animation: dots-spin 2.4s steps(6) infinite;
    }
    :global(.group:hover) .dots-spin {
      animation-duration: 0.9s;
    }
  }
  @keyframes dots-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
