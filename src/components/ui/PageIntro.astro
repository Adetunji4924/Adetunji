---
/** Inner-page header: a small label, a large title, a lead line, optional actions. */
export interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  id?: string;
}
const { eyebrow, title, lead, id = 'page-title' } = Astro.props;
---

<header class="container-site pt-10 pb-12 md:pt-20 md:pb-16">
  <p class="inline-flex items-center gap-2 rounded-full bg-paper-2 px-3 py-1 text-sm text-muted" data-reveal>
    <span class="size-2 rounded-full bg-yellow ring-1 ring-ink/20" aria-hidden="true"></span>
    {eyebrow}
  </p>
  <h1 {id} class="mt-6 max-w-4xl text-[length:var(--text-display)] leading-[1.02]" data-reveal="1">
    <slot name="title">{title}</slot>
  </h1>
  {
    lead && (
      <p class="mt-6 max-w-2xl text-[length:var(--text-lead)] leading-relaxed text-muted" data-reveal="2">
        {lead}
      </p>
    )
  }
  {
    Astro.slots.has('default') && (
      <div class="mt-8 flex flex-wrap gap-3" data-reveal="3">
        <slot />
      </div>
    )
  }
</header>
