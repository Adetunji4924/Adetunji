---
/**
 * Organisations, products and brands from the work on this site, as a slow
 * marquee of discs. Names only: no client logos are used without permission.
 * The commission and payout platform is deliberately absent (confidential).
 */
const items = [
  { name: 'Greenleaf Africa', size: 'lg' },
  { name: 'Vehtriq', size: 'md' },
  { name: 'Equalsphere', size: 'lg' },
  { name: 'Finham', size: 'sm' },
  { name: 'Ensome', size: 'md' },
  { name: 'Finspa', size: 'sm' },
  { name: 'Pure Match', size: 'md' },
  { name: 'AWAH Books', size: 'lg' },
] as const;
const sizes = { sm: 'size-24 md:size-28 text-sm', md: 'size-28 md:size-32 text-base', lg: 'size-32 md:size-40 text-lg' };
---

<section aria-labelledby="marquee-title" class="frame-rule">
  <div class="container-site py-6 md:py-8">
    <h2 id="marquee-title" class="text-sm font-medium">Teams, products and brands I've worked with</h2>
    <div class="marquee card mt-4 overflow-hidden py-10 md:py-14">
      <div class="track flex w-max items-center">
        {
          [0, 1].map((copy) => (
            <ul class="flex items-center gap-4 pr-4 md:gap-6 md:pr-6" aria-hidden={copy === 1 ? 'true' : undefined}>
              {items.map((it) => (
                <li
                  class:list={[
                    'on-dark grid shrink-0 place-items-center rounded-full bg-night p-3 dark:ring-1 dark:ring-white/12 text-center leading-tight font-semibold tracking-tight text-snow shadow-[var(--shadow-soft)]',
                    sizes[it.size],
                  ]}
                >
                  {it.name}
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .marquee {
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .track {
      animation: marquee 40s linear infinite;
    }
    .marquee:hover .track {
      animation-play-state: paused;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      width: auto;
      justify-content: center;
    }
    .track > ul:last-child {
      display: none;
    }
    .track > ul {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
