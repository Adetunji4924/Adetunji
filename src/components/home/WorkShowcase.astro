---
import ProjectVisual from '@/components/work/ProjectVisual.astro';
import VisualCard from '@/components/work/VisualCard.astro';
import Highlights from '@/components/work/Highlights.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { getWork, type Work } from '@/lib/content';
import { categories, type CategoryKey } from '@/content.config';
import { hashtag as tag } from '@/lib/format';

export interface Props {
  /** Section heading. The Work page uses its own h1, so this becomes a subheading there. */
  title?: string;
  /** Show summaries, stack and external links on the earlier-work cards (Work page). */
  archiveDetail?: boolean;
}
const { title = 'Work.', archiveDetail = false } = Astro.props;

const all = await getWork();
const caseStudies = all.filter((w) => w.data.tier === 'case-study');
const archive = all.filter((w) => w.data.tier === 'archive');
// Recent live websites get their own group, ahead of the earlier archive.
const groups = [
  { key: 'websites', title: 'Websites', aside: ', designed and built. All live.', items: archive.filter((w) => w.data.archiveGroup === 'websites') },
  { key: 'earlier', title: 'Earlier work', aside: ', in engineering and design.', items: archive.filter((w) => w.data.archiveGroup !== 'websites') },
].filter((g) => g.items.length > 0);

const counts = (Object.keys(categories) as CategoryKey[])
  .map((key) => ({ key, label: categories[key], count: all.filter((w) => w.data.category === key).length }))
  .filter((c) => c.count > 0);

const href = (w: Work) => (w.data.tier === 'case-study' ? `/work/${w.id}` : `/work#${w.id}`);
---

<section id="work" data-section="Work" aria-labelledby="work-title" class="frame-rule">
  <div class="container-site pt-16 pb-6 md:pt-24">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <h2 id="work-title" class="text-[length:var(--text-h2)]">{title}</h2>

      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between lg:justify-end" data-work-controls hidden>
        <div role="group" aria-label="Filter work by category" class="flex flex-wrap gap-1 rounded-full bg-paper-2 p-1">
          <button type="button" class="chip" aria-pressed="true" data-filter="all">
            All <span class="text-[0.7rem] text-muted tabular-nums">{all.length}</span>
          </button>
          {
            counts.map((c) => (
              <button type="button" class="chip" aria-pressed="false" data-filter={c.key}>
                {c.label} <span class="text-[0.7rem] text-muted tabular-nums">{c.count}</span>
              </button>
            ))
          }
        </div>
        <div role="group" aria-label="Layout" class="flex gap-1 self-start rounded-full bg-paper-2 p-1 sm:self-auto">
          <button type="button" class="chip" aria-pressed="true" data-view="showcase">
            <Icon name="layers" class="size-3.5" /> Showcase
          </button>
          <button type="button" class="chip" aria-pressed="false" data-view="grid">
            <Icon name="blocks" class="size-3.5" /> Grid
          </button>
        </div>
      </div>
    </div>
    <p class="sr-only" aria-live="polite" data-work-status></p>
  </div>

  <!-- Showcase: case studies in full, then the archive -->
  <div data-layout="showcase">
    {
      caseStudies.map((w) => (
        <article class="work-item frame-rule" data-category={w.data.category} aria-labelledby={`cs-${w.id}`}>
          <div class="container-site py-14 md:py-20">
            <header class="max-w-3xl" data-reveal>
              <h3 id={`cs-${w.id}`} class="text-[length:var(--text-h3)] leading-[1.15]">
                {w.data.title}.{w.data.headline && <span class="text-muted"> {w.data.headline}</span>}
              </h3>
              <p class="mt-3 flex flex-wrap gap-x-3 text-xs text-muted">
                <span>{tag(categories[w.data.category])}</span>
                <span>{tag(w.data.status)}</span>
              </p>
            </header>

            <div class="mt-10 grid gap-3 lg:grid-cols-[1.15fr_1fr]">
              <div data-reveal>
                <VisualCard project={w} href={href(w)} class="h-full" />
              </div>

              <div class="card flex flex-col gap-6 p-3" data-reveal="1">
                <div class="card-inner p-6 text-[length:var(--text-lead)] leading-relaxed">{w.data.summary}</div>
                <div class="mt-auto px-3 pb-3">
                  <p class="text-sm text-muted">Role: {w.data.role}</p>
                  {(w.data.team || w.data.tech.length > 0) && (
                    <p class="mt-2 text-sm">
                      {w.data.team ?? `${w.data.techLabel}: ${w.data.tech.slice(0, 4).join(', ')}`}
                    </p>
                  )}
                  <div class="mt-5 flex justify-end">
                    <Button href={href(w)} icon="dots">
                      Read the case study<span class="sr-only">: {w.data.title}</span>
                    </Button>
                  </div>
                </div>
              </div>
            </div>

            <Highlights items={w.data.highlights} class="mt-3" />
          </div>
        </article>
      ))
    }

    {groups.map((g) => (
    <div class="frame-rule" data-work-group id={g.key === 'websites' ? 'websites' : undefined}>
      <div class="container-site py-14 md:py-20">
        <h3 class="text-[length:var(--text-h3)]">{g.title}<span class="text-muted">{g.aside}</span></h3>
        <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            g.items.map((w, i) => (
              <li id={w.id} class="work-item scroll-mt-28" data-category={w.data.category} data-reveal={String(i % 3)}>
                {archiveDetail ? (
                  <div class="card flex h-full flex-col p-3">
                    <ProjectVisual project={w} sizes="(min-width: 64rem) 24vw, (min-width: 40rem) 45vw, 100vw" class="rounded-[1.1rem]" />
                    <div class="flex flex-1 flex-col px-3 pt-5 pb-3">
                      <h4 class="font-medium">{w.data.title}</h4>
                      <p class="mt-1 text-sm text-muted">{w.data.role}</p>
                      <p class="mt-3 text-sm leading-relaxed">{w.data.summary}</p>
                      {w.data.tech.length > 0 && (
                        <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={`${w.data.title}: ${w.data.techLabel}`}>
                          {w.data.tech.map((t) => (
                            <li class="rounded-full bg-surface px-2.5 py-1 text-xs">{t}</li>
                          ))}
                        </ul>
                      )}
                      {w.data.links.length > 0 && (
                        <ul class="mt-auto flex flex-wrap gap-2 pt-5">
                          {w.data.links.map((l) => (
                            <li>
                              <a href={l.href} target="_blank" rel="noopener noreferrer" class="inline-flex h-9 items-center gap-1.5 rounded-full bg-ink px-4 text-xs font-medium text-paper hover:bg-ink-2">
                                {l.label} ↗<span class="sr-only"> for {w.data.title} (opens in a new tab)</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </div>
                ) : (
                  <a href={href(w)} class="card group flex h-full flex-col p-3">
                    <ProjectVisual project={w} sizes="(min-width: 64rem) 24vw, (min-width: 40rem) 45vw, 100vw" class="rounded-[1.1rem]" />
                    <div class="px-3 pt-5 pb-3">
                      <p class="font-medium group-hover:underline">{w.data.title}</p>
                      <p class="mt-1 text-sm text-muted">{w.data.role}</p>
                    </div>
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    ))}
  </div>

  <!-- Grid: everything as equal cards (enabled by JS) -->
  <div data-layout="grid" hidden>
    <div class="frame-rule">
      <ul class="container-site grid gap-3 py-14 sm:grid-cols-2 lg:grid-cols-3">
        {
          all.map((w) => (
            <li class="work-item" data-category={w.data.category}>
              <a href={href(w)} class="card group flex h-full flex-col p-3">
                <ProjectVisual project={w} sizes="(min-width: 64rem) 24vw, (min-width: 40rem) 45vw, 100vw" class="rounded-[1.1rem]" />
                <div class="flex flex-1 flex-col px-3 pt-5 pb-3">
                  <p class="font-medium group-hover:underline">{w.data.title}</p>
                  <p class="mt-1 text-sm text-muted">{w.data.summary}</p>
                  <p class="mt-auto pt-4 text-xs text-muted">{categories[w.data.category]} · {w.data.status}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 2rem;
    padding-inline: 0.8rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-muted);
    transition:
      background-color 200ms,
      color 200ms,
      box-shadow 200ms;
  }
  .chip:hover {
    color: var(--color-ink);
  }
  .chip[aria-pressed='true'] {
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: var(--shadow-soft);
  }
</style>

<script>
  const controls = document.querySelector<HTMLElement>('[data-work-controls]');
  const section = document.getElementById('work');
  if (controls && section) {
    controls.hidden = false;
    const status = section.querySelector<HTMLElement>('[data-work-status]');
    const layouts = section.querySelectorAll<HTMLElement>('[data-layout]');
    let filter = 'all';
    let view = 'showcase';

    const apply = () => {
      layouts.forEach((l) => (l.hidden = l.dataset.layout !== view));
      let shown = 0;
      section.querySelectorAll<HTMLElement>(`[data-layout="${view}"] .work-item`).forEach((item) => {
        const match = filter === 'all' || item.dataset.category === filter;
        item.hidden = !match;
        if (match) {
          shown++;
          item.querySelectorAll('[data-reveal]').forEach((r) => r.classList.add('is-revealed'));
          if (item.hasAttribute('data-reveal')) item.classList.add('is-revealed');
        }
      });
      section.querySelectorAll<HTMLElement>('[data-work-group]').forEach((g) => {
        g.hidden = !g.querySelector('.work-item:not([hidden])');
      });
      if (status) status.textContent = `${shown} ${shown === 1 ? 'project' : 'projects'} shown`;
    };

    controls.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) =>
      b.addEventListener('click', () => {
        filter = b.dataset.filter ?? 'all';
        controls.querySelectorAll('[data-filter]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        apply();
      }),
    );
    controls.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) =>
      b.addEventListener('click', () => {
        view = b.dataset.view ?? 'showcase';
        controls.querySelectorAll('[data-view]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        apply();
      }),
    );
  }
</script>
