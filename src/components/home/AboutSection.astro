---
import Button from '@/components/ui/Button.astro';
import DotTiles from '@/components/ui/DotTiles.astro';
import Journey from '@/components/about/Journey.astro';
---

<section id="about" data-section="About" aria-labelledby="about-title" class="frame-rule">
  <div class="container-site py-16 md:py-24">
    <p class="text-sm text-muted" data-reveal>About me</p>
    <h2 id="about-title" class="mt-3 max-w-3xl text-[length:var(--text-h2)] leading-[1.12]" data-reveal="1">
      From design to systems, products and leadership.
    </h2>
    <div class="mt-5 max-w-3xl space-y-3 leading-relaxed text-muted" data-reveal="2">
      <p>
        I started in creative design, moved into frontend engineering and grew into full-stack development, systems
        architecture and product. Today I'm <span class="text-ink">Head of IT at Greenleaf Africa</span>, and I build
        products of my own.
      </p>
      <p>
        My degree is a B.Sc. (Ed.) in Mathematics from the University of Ilorin. Outside work I read widely: philosophy,
        psychology and why people decide the way they do.
      </p>
    </div>

    <DotTiles class="mt-12" />

    <div class="mt-20 md:mt-24">
      <h3 class="text-[length:var(--text-h3)]" data-reveal>Journey</h3>
      <Journey class="mt-6" />
      <div class="mt-10" data-reveal>
        <Button href="/about" variant="secondary">More about me</Button>
      </div>
    </div>
  </div>
</section>
