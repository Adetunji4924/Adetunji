---
/** A statement, then a bento of real project visuals. Every tile links to the work. */
import ProjectVisual from '@/components/work/ProjectVisual.astro';
import { getWork } from '@/lib/content';

const all = await getWork();
const byId = Object.fromEntries(all.map((w) => [w.id, w]));
// Layout order and spans for a 3-column bento.
const layout: { id: string; span?: string }[] = [
  { id: 'commission-payout-platform', span: 'md:col-span-2' },
  { id: 'finham' },
  { id: 'vehtriq' },
  { id: 'wealth' },
  { id: 'finspa' },
  { id: 'ensome' },
  { id: 'equalsphere', span: 'md:col-span-2' },
  { id: 'pure-match' },
  { id: 'awah-books', span: 'md:col-span-2' },
];
const tiles = layout.flatMap((t) => (byId[t.id] ? [{ ...t, project: byId[t.id]! }] : []));
---

<section aria-labelledby="gallery-title" class="frame-rule">
  <div class="container-site py-16 md:py-24">
    <h2 id="gallery-title" class="max-w-4xl text-[length:var(--text-h2)] leading-[1.12]" data-reveal>
      I lead the architecture, build across the stack, and shape products around the people who use them.
    </h2>

    <ul class="card mt-10 flex snap-x snap-mandatory gap-3 overflow-x-auto p-3 [scrollbar-width:none] md:mt-14 md:grid md:grid-cols-3 md:overflow-visible" aria-label="Project visuals">
      {
        tiles.map(({ project, span }, i) => {
          const href = project.data.tier === 'case-study' ? `/work/${project.id}` : `/work#${project.id}`;
          return (
            <li class:list={['group relative w-[82%] shrink-0 snap-start md:w-auto', span]} data-reveal={String(i % 3)}>
              <a href={href} class="block overflow-hidden rounded-[1.1rem]">
                <ProjectVisual
                  project={project}
                  sizes="(min-width: 64rem) 34vw, 100vw"
                  class:list={[
                    'rounded-[1.1rem] transition-transform duration-700 ease-[var(--ease-out-soft)] group-hover:scale-[1.02]',
                    span ? 'md:aspect-[2/1]' : 'md:aspect-square',
                  ]}
                />
                <span class="glass absolute top-3 left-3 inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-medium text-ink">
                  {project.data.title}
                  <span class="sr-only">: {project.data.summary}</span>
                  <svg viewBox="0 0 16 16" class="size-3" fill="none" aria-hidden="true">
                    <path d="M4 12 12 4M5.5 4H12v6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                  </svg>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
