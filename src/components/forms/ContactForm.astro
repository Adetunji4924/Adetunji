---
/**
 * Contact form, handled by the Cloudflare Worker at /api/contact (worker/index.ts).
 * With JS it submits via fetch and shows inline states; without JS it posts
 * natively and lands on /contact/thanks or /contact/error.
 */
import Dots from '@/components/ui/Dots.astro';
import { site } from '@/config/site';

const field =
  'mt-2 block w-full rounded-2xl border border-line bg-surface px-4 py-3.5 text-base text-ink shadow-[var(--shadow-soft)] placeholder:text-muted/80 transition-[border-color,box-shadow] focus:border-ink focus:outline-none focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-ink aria-[invalid=true]:border-[#b3261e] dark:aria-[invalid=true]:border-[#ff8a80]';
const label = 'text-sm font-medium';
const error = 'mt-2 hidden text-sm font-medium text-[#b3261e] dark:text-[#ff8a80]';
---

<form method="POST" action="/api/contact" novalidate class="space-y-6" data-contact-form data-email={site.email} id="contact-form">
  <p class="sr-only" aria-hidden="true">
    <label>Leave this empty: <input name="company" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="cf-name" class={label}>Name</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="120" class={field} aria-describedby="cf-name-error" />
      <p id="cf-name-error" class={error} data-error-for="name">Please tell me your name.</p>
    </div>
    <div>
      <label for="cf-email" class={label}>Email</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="200" class={field} aria-describedby="cf-email-error" />
      <p id="cf-email-error" class={error} data-error-for="email">Please enter a valid email address.</p>
    </div>
  </div>

  <div>
    <label for="cf-subject" class={label}>Subject <span class="font-normal text-muted">(optional)</span></label>
    <input id="cf-subject" name="subject" type="text" maxlength="160" class={field} />
  </div>

  <div>
    <label for="cf-message" class={label}>Message</label>
    <textarea id="cf-message" name="message" rows="6" required minlength="10" maxlength="5000" class={field} aria-describedby="cf-message-error"></textarea>
    <p id="cf-message-error" class={error} data-error-for="message">Please write a message (at least 10 characters).</p>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-4 pt-2">
    <p class="text-sm text-muted">Messages come straight to my inbox.</p>
    <button
      type="submit"
      class="group inline-flex h-12 items-center gap-2.5 rounded-full bg-ink pr-6 pl-1.5 font-medium text-paper shadow-[var(--shadow-soft)] transition-[transform,background-color] duration-300 ease-[var(--ease-spring)] hover:-translate-y-0.5 hover:bg-ink-2 disabled:cursor-wait disabled:opacity-70"
      data-submit
    >
      <Dots class="size-9" />
      <span data-submit-label>Send message</span>
    </button>
  </div>

  <div role="status" aria-live="polite" tabindex="-1" class="hidden rounded-2xl p-5 outline-none" data-form-status></div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const fields = ['name', 'email', 'message'] as const;
    const email = form.dataset.email ?? '';

    const control = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement;
    const errorEl = (n: string) => form.querySelector<HTMLElement>(`[data-error-for="${n}"]`)!;

    function validateField(n: string) {
      const el = control(n);
      const valid = el.checkValidity() && el.value.trim().length > 0;
      el.setAttribute('aria-invalid', String(!valid));
      errorEl(n).classList.toggle('hidden', valid);
      return valid;
    }

    fields.forEach((n) => control(n).addEventListener('blur', () => control(n).value && validateField(n)));

    // Built with DOM nodes, not innerHTML, so nothing from the response is ever parsed as HTML.
    function showStatus(kind: 'success' | 'error', strong: string, rest: string, withEmail = false) {
      status.className = `rounded-2xl p-5 outline-none ${kind === 'success' ? 'bg-yellow text-night' : 'bg-[#fbe9e7] text-[#7a1c14]'}`;
      const b = document.createElement('strong');
      b.textContent = strong;
      status.replaceChildren(b, ` ${rest}`);
      if (withEmail && email) {
        const a = document.createElement('a');
        a.href = `mailto:${email}`;
        a.className = 'underline';
        a.textContent = email;
        status.append(' ', a, '.');
      }
      status.focus();
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const results = fields.map(validateField);
      if (results.includes(false)) {
        control(fields[results.indexOf(false)]!).focus();
        return;
      }
      submit.disabled = true;
      submitLabel.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
        if (!res.ok || !data.ok) throw new Error(data.error ?? String(res.status));
        form.reset();
        fields.forEach((n) => control(n).removeAttribute('aria-invalid'));
        showStatus('success', 'Thank you. Your message has been sent.', 'I’ll get back to you soon.');
      } catch (err) {
        const code = err instanceof Error ? err.message : '';
        if (code === 'invalid_fields') {
          showStatus('error', 'Something in the form needs another look.', 'Please check your name, email and message.');
        } else if (code === 'not_configured') {
          showStatus('error', 'The form isn’t switched on yet.', 'Please email me directly at', true);
        } else {
          showStatus('error', 'Your message didn’t go through.', 'Please try again, or email me directly at', true);
        }
      } finally {
        submit.disabled = false;
        submitLabel.textContent = 'Send message';
      }
    });
  }
</script>
