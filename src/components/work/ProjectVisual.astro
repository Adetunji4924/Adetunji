---
/**
 * Project cover. Uses the approved image when there is one; otherwise an
 * informational graphic built only from facts in the case study.
 */
import { Image } from 'astro:assets';
import type { Work } from '@/lib/content';

export interface Props {
  project: Work;
  priority?: boolean;
  sizes?: string;
  class?: string;
}
const { project, priority = false, sizes = '(min-width: 64rem) 58vw, 100vw', class: className = '' } = Astro.props;
const { cover, coverAlt, visual, title } = project.data;

const domains = ['Vehicles', 'Drivers', 'Maintenance', 'Trips', 'Compliance', 'Fuel costs'];
const cx = 300;
const cy = 200;
const r = 150;
const nodes = domains.map((label, i) => {
  const a = (i / domains.length) * Math.PI * 2 - Math.PI / 2;
  return { label, x: cx + Math.cos(a) * r * 1.35, y: cy + Math.sin(a) * r * 0.86 };
});
---

<div class:list={['relative aspect-[3/2] w-full overflow-hidden rounded-[1.25rem]', className]}>
  {
    cover ? (
      <Image
        src={cover}
        alt={coverAlt ?? title}
        widths={[480, 800, 1200, 1600]}
        sizes={sizes}
        priority={priority}
        class="!h-full !max-h-none w-full object-cover"
      />
    ) : visual === 'modules' ? (
      <div class="on-dark flex h-full flex-col justify-between bg-night p-[6%] text-snow">
        <svg viewBox="0 0 300 100" class="w-full" role="img" aria-label="Grid of 75 squares representing roughly 75 modules">
          {Array.from({ length: 75 }, (_, i) => (
            <rect
              x={(i % 15) * 20 + 2}
              y={Math.floor(i / 15) * 20 + 2}
              width="16"
              height="16"
              rx="2"
              fill="none"
              stroke="currentColor"
              stroke-opacity="0.55"
            />
          ))}
        </svg>
        <div class="flex items-end justify-between gap-4">
          <p class="text-[clamp(2.5rem,6vw,4.5rem)] leading-none font-medium tracking-tight">
            ≈75<span class="ml-2 align-top font-sans text-sm text-muted-dark">modules</span>
          </p>
          <p class="hidden max-w-[14rem] text-right text-sm text-muted-dark sm:block">Commission &amp; payout platform · Pilot phase</p>
        </div>
      </div>
    ) : visual === 'domains' ? (
      <div class="on-dark h-full bg-night">
        <svg
          viewBox="0 0 600 400"
          class="h-full w-full"
          role="img"
          aria-label="Vehtriq product areas: vehicles, drivers, maintenance, trips, compliance and fuel costs, connected to AI-assisted insights"
        >
          {nodes.map((n) => (
            <line x1={cx} y1={cy} x2={n.x} y2={n.y} stroke="#6e6e6e" stroke-width="1" stroke-dasharray="3 5" />
          ))}
          {nodes.map((n) => (
            <g>
              <rect x={n.x - 58} y={n.y - 17} width="116" height="34" rx="17" fill="#1b1b1b" stroke="#6e6e6e" />
              <text x={n.x} y={n.y + 5} text-anchor="middle" font-size="14" font-family="Inter Variable, sans-serif" fill="#f8f8f8">
                {n.label}
              </text>
            </g>
          ))}
          <circle cx={cx} cy={cy} r="62" fill="#f0f000" />
          <text x={cx} y={cy - 4} text-anchor="middle" font-size="15" font-weight="600" font-family="Inter Variable, sans-serif" fill="#111111">
            AI-assisted
          </text>
          <text x={cx} y={cy + 15} text-anchor="middle" font-size="15" font-weight="600" font-family="Inter Variable, sans-serif" fill="#111111">
            insights
          </text>
        </svg>
      </div>
    ) : visual === 'platform' ? (
      <div class="on-dark flex h-full flex-col justify-between bg-yellow p-[6%] text-night">
        <p class="text-[clamp(2.25rem,5.5vw,4.25rem)] leading-none font-medium tracking-tight">{title}</p>
        <div class="space-y-2" role="img" aria-label="Diagram: multiple product modules built on a NestJS backend">
          <div class="grid grid-cols-4 gap-2" aria-hidden="true">
            {['Module', 'Module', 'Module', 'Module'].map((m) => (
              <div class="rounded-md border border-night/70 bg-snow py-3 text-center text-xs font-medium">{m}</div>
            ))}
          </div>
          <div class="rounded-md bg-night py-3 text-center text-xs font-semibold text-snow" aria-hidden="true">
            NestJS backend
          </div>
          <p class="pt-1 text-sm text-night/75" aria-hidden="true">Workforce inclusion platform · In development</p>
        </div>
      </div>
    ) : (
      <div class="flex h-full items-end bg-paper-2 p-[6%]">
        <p class="text-5xl font-medium tracking-tight">{title}</p>
      </div>
    )
  }
</div>
