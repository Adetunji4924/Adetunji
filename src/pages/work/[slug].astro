---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { canonicalUrl } from '@/lib/url';
import ProjectVisual from '@/components/work/ProjectVisual.astro';
import VisualCard from '@/components/work/VisualCard.astro';
import Highlights from '@/components/work/Highlights.astro';
import CtaCard from '@/components/ui/CtaCard.astro';
import { getCaseStudies, type Work } from '@/lib/content';
import { categories } from '@/content.config';
import { creativeWorkSchema, breadcrumbSchema } from '@/lib/schema';
import { hashtag } from '@/lib/format';

export async function getStaticPaths() {
  const all = await getCaseStudies();
  return all.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: all[(i + 1) % all.length] },
  }));
}

interface Props {
  project: Work;
  next: Work | undefined;
}
const { project, next } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const sections = headings.filter((h) => h.depth === 2);

// Use the headline in the title only when it still fits in a search result (~60 chars with the name).
const withHeadline = data.headline ? `${data.title}: ${data.headline.replace(/\.$/, '')}` : '';
const pageTitle = withHeadline && withHeadline.length <= 48 ? withHeadline : `${data.title}: case study`;

const meta = [
  { label: 'Role', value: data.role },
  { label: 'Status', value: data.status },
  { label: 'Category', value: categories[data.category] },
  ...(data.team ? [{ label: 'Team', value: data.team }] : []),
  ...(data.period ? [{ label: 'Period', value: data.period }] : []),
];
---

<BaseLayout
  title={pageTitle}
  description={data.summary}
  type="article"
  jsonLd={[
    creativeWorkSchema({ title: data.title, description: data.summary, url: canonicalUrl(Astro.url, Astro.site), base: Astro.site, keywords: [categories[data.category], ...data.tech] }),
    breadcrumbSchema(Astro.site, [{ name: 'Work', path: '/work' }, { name: data.title, path: `/work/${project.id}` }]),
  ]}
>
  <article>
    <header class="container-site pt-10 md:pt-16">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-1.5 text-sm">
          <li><a href="/work" class="rounded-full bg-paper-2 px-3 py-1 text-muted hover:text-ink">Work</a></li>
          <li aria-hidden="true" class="text-muted">/</li>
          <li><span aria-current="page" class="rounded-full bg-surface px-3 py-1 shadow-[var(--shadow-soft)]">{data.title}</span></li>
        </ol>
      </nav>

      <h1 class="mt-8 max-w-4xl text-[length:var(--text-display)] leading-[1.02]" data-reveal>
        {data.title}.{data.headline && <span class="text-muted"> {data.headline}</span>}
      </h1>
      <p class="mt-5 flex flex-wrap gap-x-3 text-sm text-muted" data-reveal="1">
        <span>{hashtag(categories[data.category])}</span>
        <span>{hashtag(data.status)}</span>
      </p>

      <div class="mt-10 grid gap-3 lg:grid-cols-[1.4fr_1fr]">
        <div data-reveal>
          <VisualCard project={project} priority sizes="(min-width: 76rem) 44rem, 100vw" class="h-full" />
        </div>

        <div class="card flex flex-col gap-3 p-3" data-reveal="1">
          <p class="card-inner p-6 text-[length:var(--text-lead)] leading-relaxed">{data.summary}</p>
          <dl class="grid gap-x-6 gap-y-4 px-3 py-3 text-sm sm:grid-cols-2">
            {
              meta.map((m) => (
                <div>
                  <dt class="text-muted">{m.label}</dt>
                  <dd class="mt-1 font-medium">{m.value}</dd>
                </div>
              ))
            }
          </dl>
          {
            data.tech.length > 0 && (
              <div class="px-3 pb-3">
                <p class="text-sm text-muted">{data.techLabel}</p>
                <ul class="mt-2 flex flex-wrap gap-1.5">
                  {data.tech.map((t) => (
                    <li class="rounded-full bg-surface px-2.5 py-1 text-xs font-medium">{t}</li>
                  ))}
                </ul>
              </div>
            )
          }
          {
            data.links.length > 0 && (
              <ul class="mt-auto flex flex-wrap gap-2 px-3 pb-3">
                {data.links.map((l) => (
                  <li>
                    <a href={l.href} target="_blank" rel="noopener noreferrer" class="inline-flex h-9 items-center gap-1.5 rounded-full bg-ink px-4 text-xs font-medium text-paper hover:bg-ink-2">
                      {l.label} ↗<span class="sr-only"> (opens in a new tab)</span>
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </div>

      <Highlights items={data.highlights} class="mt-3" />
    </header>

    <div class="frame-rule mt-16 md:mt-24">
      <div class="container-site grid gap-10 py-16 md:py-20 lg:grid-cols-[16rem_1fr] lg:gap-16">
        <aside aria-label="Project contents" class="hidden lg:block">
          {
            sections.length > 2 && (
              <nav aria-label="On this page" class="card sticky top-28 p-3">
                <p class="px-3 pt-2 text-sm font-medium text-muted">On this page</p>
                <ol class="mt-2 space-y-0.5 text-sm" data-toc>
                  {sections.map((s) => (
                    <li>
                      <a href={`#${s.slug}`} class="toc-link block rounded-xl px-3 py-2 text-muted transition-colors hover:bg-surface hover:text-ink">
                        {s.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }
        </aside>
        <div class="prose-editorial [&_h2]:scroll-mt-28">
          <Content />
        </div>
      </div>
    </div>
  </article>

  {
    next && next.id !== project.id && (
      <aside aria-labelledby="next-title" class="frame-rule">
        <div class="container-site py-16 md:py-20">
          <a href={`/work/${next.id}`} class="card group grid items-center gap-3 p-3 md:grid-cols-[1fr_1.2fr]">
            <div class="p-5 md:p-8">
              <p class="text-sm text-muted" id="next-title">Next case study</p>
              <p class="mt-4 text-[length:var(--text-h2)] leading-[1.1] font-medium tracking-tight">
                {next.data.title}.
                {next.data.headline && <span class="text-muted"> {next.data.headline}</span>}
              </p>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium group-hover:underline">
                Read the case study
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </span>
            </div>
            <ProjectVisual project={next} sizes="(min-width: 64rem) 40vw, 100vw" class="rounded-[1.1rem]" />
          </a>
        </div>
      </aside>
    )
  }

  <CtaCard title="Want to talk about this work?" />
</BaseLayout>

<style>
  .toc-link[aria-current='true'] {
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: var(--shadow-soft);
  }
</style>

<script>
  // Highlight the section being read in the contents card.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')];
  if (links.length) {
    const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          links.forEach((a) => a.removeAttribute('aria-current'));
          byId.get(e.target.id)?.setAttribute('aria-current', 'true');
        }),
      { rootMargin: '-20% 0px -70% 0px' },
    );
    byId.forEach((_, id) => {
      const h = document.getElementById(id);
      if (h) io.observe(h);
    });
  }
</script>
