---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/ui/PageIntro.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import DotTiles from '@/components/ui/DotTiles.astro';
import Journey from '@/components/about/Journey.astro';
import Capabilities from '@/components/home/Capabilities.astro';
import CtaCard from '@/components/ui/CtaCard.astro';
import StatusPill from '@/components/work/StatusPill.astro';
import { principles } from '@/data/principles';
import { profilePageSchema, breadcrumbSchema } from '@/lib/schema';
import { canonicalUrl } from '@/lib/url';

const now = [
  { icon: 'layers', role: 'Head of IT', org: 'Greenleaf Africa', href: undefined, note: 'From March 2026', status: undefined },
  { icon: 'map', role: 'Founder', org: 'Vehtriq', href: '/work/vehtriq', note: 'AI-powered fleet intelligence', status: 'In development' },
  { icon: 'compass', role: 'Co-founder, Product Lead & Creative Director', org: 'Equalsphere', href: '/work/equalsphere', note: 'A workforce inclusion platform', status: 'In development' },
] as const;

const description =
  'Head of IT at Greenleaf Africa, founder of Vehtriq and co-founder of Equalsphere. From design to engineering, systems architecture and product.';

const exploring = [
  'Artificial intelligence and emerging technologies',
  'Business strategy and entrepreneurship',
  'Leadership, psychology and human behaviour',
  'Philosophy, reading and personal development',
];
---

<BaseLayout
  title="About Adetunji Adewole: Head of IT, Systems Architect & Founder"
  description={description}
  type="profile"
  jsonLd={[
    profilePageSchema({ url: canonicalUrl(Astro.url, Astro.site), base: Astro.site, name: 'About Adetunji Adewole', description }),
    breadcrumbSchema(Astro.site, [{ name: 'About', path: '/about' }]),
  ]}
>
  <PageIntro eyebrow="About me" title="">
    <Fragment slot="title">A builder who cares about the <span class="mark">why</span> as much as the how.</Fragment>
  </PageIntro>

  <!-- Story -->
  <section aria-labelledby="story-title" class="container-site pb-16 md:pb-24">
    <div class="grid gap-3 lg:grid-cols-[1fr_1.6fr]">
      <div class="flex flex-col gap-3">
        <div class="card p-6" data-reveal>
          <h2 id="story-title" class="text-sm font-medium text-muted">The short version</h2>
          <p class="mt-4 text-[length:var(--text-h4)] leading-snug font-medium">
            I work where technology, business and people meet.
          </p>
        </div>
        <div class="on-dark rounded-[var(--radius-card)] bg-night p-6 text-snow dark:ring-1 dark:ring-white/10" data-reveal="1">
          <p class="text-sm text-muted-dark">Education</p>
          <p class="mt-4 text-[length:var(--text-h4)] font-medium">B.Sc. (Ed.) Mathematics</p>
          <p class="mt-1 text-muted-dark">University of Ilorin</p>
        </div>
      </div>
      <div class="card p-3" data-reveal="2">
        <div class="card-inner prose-editorial max-w-none p-6 text-[length:var(--text-body)] md:p-8">
          <p>
            I'm Adetunji Adewole. I build systems, shape products and lead technology, and I try to stay close to the
            problems those things exist to solve.
          </p>
          <p>
            My path hasn't been a straight line. I started in <strong>creative design</strong> in 2022, moved into{' '}
            <strong>frontend engineering</strong>, and grew into <strong>full-stack development</strong> and{' '}
            <strong>systems architecture</strong>. From there the questions got bigger: not just <em>how</em> to build
            something, but <em>what</em> to build and <em>why</em>. That led me to <strong>product</strong>, and to{' '}
            <strong>technology leadership</strong>.
          </p>
          <p>
            Each step added a lens rather than replacing one. Design taught me to care about the person on the other side
            of the screen. Engineering taught me precision. Architecture taught me to think in systems and trade-offs.
            Product and leadership taught me that technology only matters when it creates value for someone.
          </p>
        </div>
      </div>
    </div>
    <DotTiles class="mt-3" />
  </section>

  <!-- Now -->
  <section aria-labelledby="now-title" class="frame-rule">
    <div class="container-site py-16 md:py-24">
      <h2 id="now-title" class="text-[length:var(--text-h2)]">Now.</h2>
      <ul class="mt-10 grid gap-3 md:grid-cols-3">
        {
          now.map((n, i) => (
            <li class="card flex min-h-56 flex-col p-6" data-reveal={String(i)}>
              <div class="flex items-start justify-between gap-3">
                <Icon name={n.icon} class="size-5 text-muted" />
                {n.status ? <StatusPill kind="in-development" label={n.status} /> : <span class="rounded-full bg-yellow px-2.5 py-0.5 text-xs font-medium text-night">{n.note}</span>}
              </div>
              <div class="mt-auto pt-10">
                <p class="text-sm font-medium text-muted">
                  {n.href ? <a href={n.href} class="link-underline">{n.org}</a> : n.org}
                </p>
                <h3 class="mt-2 text-[length:var(--text-h4)] leading-snug">{n.role}</h3>
                {n.status && <p class="mt-1 text-sm text-muted">{n.note}</p>}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Journey -->
  <section aria-labelledby="journey-title" class="frame-rule">
    <div class="container-site py-16 md:py-24">
      <h2 id="journey-title" class="text-[length:var(--text-h2)]">Journey.</h2>
      <p class="mt-4 max-w-xl text-muted">Stages overlap. Product work and technology leadership run in parallel today.</p>
      <Journey detailed class="mt-10" />
    </div>
  </section>

  <Capabilities />

  <!-- Principles -->
  <section aria-labelledby="principles-title" class="frame-rule">
    <div class="container-site py-16 md:py-24">
      <h2 id="principles-title" class="text-[length:var(--text-h2)]">Principles.</h2>
      <ol class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          principles.map((p, i) => (
            <li class="card flex min-h-52 flex-col p-6" data-reveal={String(i % 3)}>
              <span class="w-fit rounded-full bg-yellow px-2.5 py-0.5 text-xs font-medium text-night tabular-nums">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="mt-auto pt-8">
                <h3 class="text-[length:var(--text-h4)] leading-snug">{p.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{p.line}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Exploring -->
  <section aria-labelledby="exploring-title" class="frame-rule">
    <div class="container-site py-16 md:py-24">
      <h2 id="exploring-title" class="text-[length:var(--text-h2)]">Beyond work.</h2>
      <p class="mt-4 max-w-xl text-muted">What I'm reading about and exploring.</p>
      <ul class="mt-8 flex flex-wrap gap-2">
        {
          exploring.map((e, i) => (
            <li class="rounded-full bg-paper-2 px-5 py-3 text-[length:var(--text-h4)]" data-reveal={String(i)}>
              {e}
            </li>
          ))
        }
      </ul>
      <div class="mt-10 flex flex-wrap gap-3" data-reveal>
        <Button href="/work" variant="secondary">See the work</Button>
        <Button href="/writing" variant="secondary">Read the writing</Button>
      </div>
    </div>
  </section>

  <div class="frame-rule pt-16 md:pt-24">
    <CtaCard />
  </div>
</BaseLayout>
