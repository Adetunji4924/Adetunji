---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { canonicalUrl } from '@/lib/url';
import CtaCard from '@/components/ui/CtaCard.astro';
import { getArticles, formatDate, readingTime, type Article } from '@/lib/content';
import { articleSchema, breadcrumbSchema } from '@/lib/schema';

export async function getStaticPaths() {
  return (await getArticles()).map((article) => ({ params: { slug: article.id }, props: { article } }));
}

interface Props {
  article: Article;
}
const { article } = Astro.props;
const { data } = article;
const { Content } = await render(article);
---

<BaseLayout
  title={data.title}
  description={data.excerpt}
  type="article"
  publishedTime={data.date}
  jsonLd={[
    articleSchema({
      title: data.title,
      description: data.excerpt,
      url: canonicalUrl(Astro.url, Astro.site),
      base: Astro.site,
      published: data.date,
      modified: data.updated,
    }),
    breadcrumbSchema(Astro.site, [{ name: 'Writing', path: '/writing' }, { name: data.title, path: `/writing/${article.id}` }]),
  ]}
>
  <article>
    <header class="container-site pt-10 md:pt-16">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-1.5 text-sm">
          <li><a href="/writing" class="rounded-full bg-paper-2 px-3 py-1 text-muted hover:text-ink">Writing</a></li>
          <li aria-hidden="true" class="text-muted">/</li>
          <li><span class="rounded-full bg-surface px-3 py-1 shadow-[var(--shadow-soft)]">{data.topic}</span></li>
        </ol>
      </nav>
      <div class="mx-auto max-w-4xl py-12 md:py-16">
        <h1 class="text-[length:var(--text-h1)] leading-[1.05]" data-reveal>{data.title}</h1>
        <p class="mt-6 text-[length:var(--text-lead)] leading-relaxed text-muted" data-reveal="1">{data.excerpt}</p>
        <p class="mt-8 flex flex-wrap gap-2 text-sm" data-reveal="2">
          <span class="rounded-full bg-paper-2 px-3 py-1"><time datetime={data.date.toISOString()}>{formatDate(data.date)}</time></span>
          <span class="rounded-full bg-paper-2 px-3 py-1">{readingTime(article.body)} min read</span>
        </p>
      </div>
    </header>
    <div class="frame-rule">
      <div class="container-site py-16 md:py-20">
        <div class="prose-editorial mx-auto">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <div class="frame-rule pt-16 md:pt-24">
    <CtaCard title="Thoughts on this? I'd like to hear them." />
  </div>
</BaseLayout>
